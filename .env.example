# Urai environment. Copy to .env at the repo root and fill in. Never commit .env.

# The operator's SERV Reasoning key, from console.openserv.ai (Settings, Keys). It pays only for the
# public demo runs on the sample workloads; teams bring their own key for their own workloads.
SERV_API_KEY=
# Read only by the research benchmark in packages/bench. The app's SERV address is fixed in code (C2).
SERV_BASE_URL=https://inference-api.openserv.ai/v1

# A free Neon Postgres project; paste the pooled connection string.
DATABASE_URL=

# Random secret used to hash visitor IPs for rate limits. Any 64 hex characters.
URAI_IP_SALT=

# Daily cap on the operator key for public demo runs, in USD.
DEMO_DAILY_BUDGET_USD=1.00

# Secret Vercel Cron sends to /api/cron/cleanup; at least 32 characters, e.g. `openssl rand -hex 32`. Missing means the clean-up always refuses.
CRON_SECRET=

# The public address of the deployed app, for share cards and absolute links, e.g. https://urai-serv.vercel.app. Local dev falls back to http://localhost:3001.
URAI_PUBLIC_URL=
